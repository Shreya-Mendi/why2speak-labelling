# Central save config. Copy to `.streamlit/secrets.toml` (local) or paste into the
# Streamlit Cloud app's Settings -> Secrets. Without this, the app saves locally
# (ephemeral on Streamlit Cloud — wiped on every redeploy!).

# ---- OPTION 1 (recommended): Postgres, e.g. Vercel/Neon free tier ----------- #
# Setup (~3 min):
#  1. vercel.com dashboard -> Storage -> Create Database -> Postgres (Neon).
#  2. Open the database -> ".env.local" / "Quickstart" tab -> copy the
#     DATABASE_URL value (starts with postgres:// or postgresql://).
#  3. Paste it below, then put this whole block into the Streamlit app's
#     Settings -> Secrets. The app creates its own `labels` table on first run.

[db]
url = "postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ---- OPTION 2 (legacy fallback): Google Sheet ------------------------------- #
# Used only if [db] is absent. Setup (~10 min):
#  1. Google Cloud -> create a service account -> download its JSON key.
#  2. Create a Google Sheet, Share it (Editor) with the service account's email.
#  3. Copy the sheet key from its URL (.../d/<SHEET_KEY>/edit) into sheet_key.
#
# [gsheets]
# sheet_key = "PASTE_SHEET_KEY_HERE"
#
# [gsheets.service_account]
# type = "service_account"
# ...
