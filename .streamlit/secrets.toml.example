# Optional central save. Copy to `.streamlit/secrets.toml` (local) or paste into the
# Streamlit Cloud app's Settings -> Secrets. Without this, the app saves locally.
#
# Setup (~10 min):
#  1. Google Cloud -> create a service account -> download its JSON key.
#  2. Create a Google Sheet, Share it (Editor) with the service account's email.
#  3. Copy the sheet key from its URL (.../d/<SHEET_KEY>/edit) into sheet_key below.
#  4. Paste the JSON key fields under [gsheets.service_account].

[gsheets]
sheet_key = "PASTE_SHEET_KEY_HERE"

[gsheets.service_account]
type = "service_account"
project_id = "your-project"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "labeller@your-project.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
