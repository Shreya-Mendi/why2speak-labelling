# Paste this into the Streamlit Cloud app under Settings -> Secrets, and keep a copy
# at .streamlit/secrets.toml for local runs. Never commit the real one.
#
# The audit shares the why2speak Neon database. It only touches its own two tables,
# w2s_slots and w2s_audit, which the app creates on first run. For a fresh database
# instead: neon.com -> create a project -> copy the postgresql:// connection string.

admin_key = "any-long-random-string"   # opens https://<app>/?admin=<admin_key>

[db]
url = "postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"
